{
  "name": "reposync",
  "version": "1.0.19",
  "private": true,
  "description": "Локальный перенос Git-репозиториев через Markdown-пакеты",
  "author": "RepoSync",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build:renderer": "node scripts/build.mjs",
    "build:electron": "tsc -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "start": "electron .",
    "test:writer": "npm run build && node scripts/check-writer-safety.cjs --v3 && node scripts/check-writer-performance.cjs --quick --assert"
  },
  "dependencies": {
    "diff": "8.0.2",
    "minimatch": "10.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "5.9.2",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "local.reposync.desktop",
    "productName": "RepoSync",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "overrides": {
    "postcss": {
      ".": "8.5.28",
      "nanoid": "3.3.19"
    },
    "node-abi": "4.35.0",
    "minimatch": {
      "brace-expansion": "5.0.9"
    },
    "electron": {
      "@types/node": "24.19.0"
    }
  }
}
