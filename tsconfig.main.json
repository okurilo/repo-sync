{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "CommonJS",
    "moduleResolution": "Node", "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist/main", "rootDir": "src"
  },
  "include": ["src/main", "src/shared", "src/preload.ts"]
}
